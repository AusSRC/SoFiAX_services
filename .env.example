# Deployment configuration. Copy to .env and edit.
# Read by survey_db (db/init.sh), survey_web (web/config/settings.py) and survey_vo (vo/render-config.sh).

PROJECT=WALLABY

# Parts of the service to deploy (comma separated), "core" is the minimal service
#   core                run, instance, detection, products and tasks
#   metadata            comment, tag, tag_detection
#   operations          observation, quality_check, external_conflict
#   wallaby_operations  tile, tile_obs, source_extraction_region, source_extraction_region_tile,
#                       survey components (requires operations)
#   wallaby_kinematics  kinematic_model, kinematic_model_3kidnas and their products
#   dingo_gama          detection_nearest_gama
# The database tables are only created on first startup. To add a module later:
#   docker exec survey_db install-modules <module>
MODULES=core,metadata,operations,wallaby_operations

# Database
DATABASE_HOST=survey_db
DATABASE_PORT=5432
DATABASE_NAME=surveydb
DATABASE_SCHEMA=survey
# DATABASE_SSLMODE=disable

# Database superuser created by the postgres image
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database users created on first startup (db/create.sql)
DATABASE_SURVEY_PASSWORD=survey_user
DATABASE_ADMIN_USERNAME=admin
DATABASE_ADMIN_PASSWORD=admin

# Web application
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
SEARCH_PATH=survey,public
DJANGO_SECRET_KEY=<django key>
DJANGO_ALLOWED_HOSTS=127.0.0.1 localhost
AUTH_GROUPS=wallaby
SITE_NAME=WALLABY Catalog
SITE_HEADER=WALLABY Catalog
SITE_TITLE=WALLABY Catalog
INDEX_TITLE=WALLABY Catalog
DEBUG=True
LOCAL=True

# Detections below these thresholds are not shown in the admin pages or manual
# inspection (optional, defaults shown, 0 to disable)
# DETECTION_MIN_N_PIX=300
# DETECTION_MIN_REL=0.7

# CARTA server for a link to the image cube on the manual inspection page (optional)
# CARTA_URL=https://vis.pawsey.org.au/carta

# Development: uncomment to use the web application over plain http
# (e.g. http://localhost:8000 without survey_nginx)
# CSRF_TRUSTED_ORIGINS=http://localhost:8000
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# TAP service
VO_SERVER_URL=http://localhost
PRODUCT_URL=http://localhost

# Database users for VO services created on first startup (db/create.sql)
VO_FEED_PASSWORD=gavoadmin
VO_TRUSTED_PASSWORD=gavo
VO_UNTRUSTED_PASSWORD=untrusted

# TAP service metadata
VO_TITLE=WALLABY Catalog
VO_SHORT_NAME=WALLABY
VO_DESCRIPTION=WALLABY - the ASKAP HI All-Sky Survey
VO_REFERENCE_URL=https://www.atnf.csiro.au/research/WALLABY/
VO_CREATION_DATE=2020-04-24
VO_CONTACT_NAME=Austin Shen
VO_CONTACT_EMAIL=austin.shen@csiro.au
VO_CONTACT_ADDRESS=7 Fairway, 2nd Floor Crawley, Perth, WA, 6009.

# TAP service tuning (optional, DaCHS defaults are used if not set)
# VO_SQL_TIMEOUT=86400
# VO_MAX_UPLOAD_SIZE=2000000000
# VO_DEFAULT_EXEC_TIME=86400
# VO_DEFAULT_EXEC_TIME_SYNC=86400
# VO_MAX_TAP_RUNNING=12
# VO_MAX_USER_UWS_RUNNING=12
# VO_HARD_MAXREC=70000000
# VO_INDEX_WORK_MEM=32768
