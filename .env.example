# Configuration of the minimal local deployment (see README.md). Copy to .env and edit.
# The configuration of a server deployment with all of the services is in server/.env.example.

PROJECT=SURVEY

# Parts of the application to install (comma separated), "core" is the minimal application
#   core        runs, instances, detections and their products, tags, comments and manual inspection
#   operations  observations, survey components, external conflicts, cross matching and release of sources
#   wallaby     tiles, source extraction regions and kinematic models (requires operations)
#   dingo       GAMA matches of detections
MODULES=core

# Web application
DEBUG=True
DJANGO_SECRET_KEY=local-development-only

# Database started by "make db". The application connects as the admin user.
POSTGRES_PASSWORD=postgres
DATABASE_ADMIN_PASSWORD=admin
DATABASE_PORT=5432

# The application is used over plain http on localhost
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
